# --- Server ---
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://outbox:outbox@localhost:5432/outbox

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=scheduled_emails

# --- Worker tuning ---
WORKER_CONCURRENCY=10
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# --- Ethereal Email (fake SMTP) ---
# Get creds from https://ethereal.email/create
ETHEREAL_USER=
ETHEREAL_PASS=
# Fallback: if creds are empty, nodemailer creates a throwaway Ethereal account on boot.
DEFAULT_FROM_NAME=ReachInbox
DEFAULT_FROM_EMAIL=hello@reachinbox.dev

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# Optional: override the channel used for rate-limit notifications
SLACK_NOTIFY_CHANNEL_ID=

# --- Sessions / misc ---
SESSION_SECRET=change-me-to-a-long-random-string
# Dev-only login endpoint (never enable in production)
ALLOW_DEV_LOGIN=false

# --- Bull Board ---
# Set a secret to protect /admin/queues (basic auth user:pass below)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
